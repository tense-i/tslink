# TSLink Environment Variables
# Copy this file to .env and modify as needed

# Override any config value with TSLINK_ prefix
# Format: TSLINK__SECTION__KEY (double underscore as separator)
TSLINK__MQTT__HOST=127.0.0.1
TSLINK__MQTT__PORT=1883
TSLINK__MQTT__USERNAME=admin
TSLINK__MQTT__PASSWORD=public

TSLINK__REDIS__URL=redis://127.0.0.1:6379

TSLINK__KAFKA__BROKERS=127.0.0.1:9092

TSLINK__DATABASE__URL=mysql://root:root@127.0.0.1:3306/tslink

TSLINK__HTTP__PORT=8080

# Runtime config
RUST_LOG=tslink=debug,rumqttc=info
RUN_ENV=dev
